# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control
# =============================================================================

# ========================
# Server Configuration
# ========================
PORT=5000
NODE_ENV=development

# ========================
# MongoDB
# ========================
# Your MongoDB connection string
# Example: mongodb://localhost:27017/online-quran
MONGO_URI=mongodb://localhost:27017/online-quran

# ========================
# JWT Authentication
# ========================
# Generate a strong random string (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Refresh Token Secret
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production

# ========================
# Stripe Payment Gateway
# ========================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# - Secret Key: Developers > API keys > Secret key (starts with sk_test_ or sk_live_)
# - Publishable Key: Developers > API keys > Publishable key (starts with pk_test_ or pk_live_)
# - Webhook Secret: Developers > Webhooks > Your endpoint > Secret (starts with whsec_)

# Stripe Secret Key (Server-side only - NEVER expose to frontend)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (For verifying webhook events)
# Use test secret for development: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Publishable Key (Safe to use in frontend)
# This should match VITE_STRIPE_PUBLISHABLE_KEY in frontend/.env
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ========================
# Frontend URL (for CORS)
# ========================
# Your React/Vue frontend URL
FRONTEND_URL=http://localhost:5173

# ========================
# Cloudinary (Image Upload)
# ========================
# Get these from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# Email Configuration (Optional)
# ========================
# For sending verification emails
# SMTP settings or service like SendGrid, Mailgun, etc.
EMAIL_SERVICE=your-email-service
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
